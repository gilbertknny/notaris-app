{
  "name": "notaris-app",
  "private": true,
  "version": "0.1.0",
  "description": "Aplikasi manajemen kantor Notaris & PPAT (MVP)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @notaris/api dev",
    "dev:worker": "pnpm --filter @notaris/api dev:worker",
    "dev:web": "pnpm --filter @notaris/web dev",
    "db:migrate": "pnpm --filter @notaris/api db:migrate",
    "db:seed": "pnpm --filter @notaris/api db:seed",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
