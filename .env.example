# Salin ke .env lalu ganti semua nilai rahasia sebelum dipakai di luar laptop Anda.
NODE_ENV=development

# Password superuser PostgreSQL (dipakai docker compose).
POSTGRES_PASSWORD=postgres
# true = isi data demo saat pertama kali dijalankan (docker compose).
SEED_DEMO=true

# Pemilik skema: hanya untuk migrasi & seed.
DATABASE_URL_MIGRATOR=postgresql://postgres:postgres@localhost:5432/notaris
# Role aplikasi (dibuat oleh migrasi, tunduk row-level security).
APP_DB_PASSWORD=ganti-password-app-ini
DATABASE_URL=postgresql://notaris_app:ganti-password-app-ini@localhost:5432/notaris

REDIS_URL=redis://localhost:6379

# 32 byte acak, base64. Buat dengan:  openssl rand -base64 32
KMS_MASTER_KEY=GANTI_DENGAN_openssl_rand_base64_32_xxxxxxxx=
HMAC_KEY=GANTI_DENGAN_openssl_rand_base64_32_yyyyyyyyy=

STORAGE_DIR=./storage
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
# true jika diakses lewat HTTPS (produksi).
COOKIE_SECURE=false
PORT=4000
